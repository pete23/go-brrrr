(ns unit.run
  "Runs every unit test namespace; exits non-zero on any failure or error."
  (:require [clojure.test :refer [run-tests]]
            ring.adapter.h2o-test
            ring.middleware.content-type-test
            ring.middleware.head-test
            ring.middleware.keyword-params-test
            ring.middleware.nested-params-test
            ring.middleware.params-test
            ring.util.codec-test
            ring.util.mime-type-test
            ring.util.parsing-test
            ring.util.request-test
            ring.util.response-test))

(defn -main [& _]
  (let [{:keys [fail error test pass]}
        (run-tests 'ring.adapter.h2o-test
                   'ring.middleware.content-type-test
                   'ring.middleware.head-test
                   'ring.middleware.keyword-params-test
                   'ring.middleware.nested-params-test
                   'ring.middleware.params-test
                   'ring.util.codec-test
                   'ring.util.mime-type-test
                   'ring.util.parsing-test
                   'ring.util.request-test
                   'ring.util.response-test)]
    (println (str "unit: " test " tests, " pass " passed, " fail " failed, " error " errors"))
    (cpp/std.exit (if (zero? (+ fail error)) 0 1))))
