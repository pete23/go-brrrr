(ns ring.adapter.h2o
  "Ring adapter for h2o (HTTP/1.1, HTTP/2 and HTTP/3 over TLS).

  Handlers run on a pool of worker threads, so they may block. Follows the Ring
  spec for synchronous handlers, with these deviations until jank has protocols
  and streams:

  * The request :body is a reader fn standing in for an InputStream: each call
    returns the next chunk of the body as a string, blocking until it arrives,
    and nil at the end. It is nil if the request has no body. Nothing is
    retained, so bodies of any size stream in bounded memory. Use
    ring.util.request/body-string to read it all into one string.
  * The response :body may be:
      nil             - empty body
      a string        - sent with a content-length
      a seq           - each element is str'd and sent as it is realized, so a
                        lazy seq streams
      a fn of 1 arg   - called with a write! fn; each (write! s) sends s. The
                        response ends when the fn returns. write! throws if the
                        client has gone away.
    Streamed bodies have no content-length. If producing a streamed body throws,
    the response is aborted so the client can tell it is incomplete.
  * Only one server per process; run-h2o blocks the calling thread.
  * Asynchronous (3-arity) handlers are not supported."
  (:require [clojure.string :as str]))

;; Bridges brrrr's C callbacks to -dispatch below. Each in-flight request gets an
;; integer id; jank code refers to the request by id, and the bridge maps ids to
;; live requests so a body reader called after its request finished fails safely
;; instead of touching freed memory.

(cpp/raw "#include <algorithm>
#include <atomic>
#include <cstdio>
#include <cstdlib>
#include <mutex>
#include <string>
#include <string_view>
#include <unordered_map>
#include <vector>
#include <gc.h>
#include \"brrrr.h\"

namespace ring_h2o
{
  using namespace jank::runtime;

  struct registry_t
  {
    std::mutex mutex;
    std::unordered_map<int64_t, brrrr_request_t *> requests;
    int64_t next_id{ 1 };
  };

  /* For methods and header names (ASCII tokens). clojure.string/lower-case builds a
   * std::locale per call, which on macOS takes a process-wide lock: a request-rate ceiling. */
  inline std::string ascii_lower(std::string s)
  {
    for(auto &c : s)
    {
      if(c >= 'A' && c <= 'Z') { c += 'a' - 'A'; }
    }
    return s;
  }

  inline registry_t &registry()
  {
    static registry_t r;
    return r;
  }

  inline brrrr_request_t *lookup(int64_t const id)
  {
    auto &r{ registry() };
    std::lock_guard<std::mutex> const lock{ r.mutex };
    auto const it{ r.requests.find(id) };
    return it == r.requests.end() ? nullptr : it->second;
  }

  inline jank_object_ref str(brrrr_str_t const s)
  {
    if(s.base == nullptr)
    { return jank_const_nil(); }
    return convert<std::string>::into_object(std::string{ s.base, s.len }).erase().raw();
  }

  inline jank_object_ref keyword(char const * const name)
  { return jank_keyword_intern(jank_string_create(\"ring.adapter.h2o\"), jank_string_create(name)); }

  /* A chunk of request body as a string, nil at the end, or :ring.adapter.h2o/closed. */
  inline object_ref read_chunk(int64_t const id)
  {
    auto * const req{ lookup(id) };
    brrrr_str_t chunk{};
    int const rc{ req == nullptr ? -1 : brrrr_read_body(req, &chunk) };
    if(rc > 0)
    { return reinterpret_cast<object *>(str(chunk)); }
    if(rc == 0)
    { return reinterpret_cast<object *>(jank_const_nil()); }
    return reinterpret_cast<object *>(keyword(\"closed\"));
  }

  inline std::vector<brrrr_header_t> to_headers(std::vector<std::string> const &flat)
  {
    std::vector<brrrr_header_t> hs;
    hs.reserve(flat.size() / 2);
    for(size_t i{}; i + 1 < flat.size(); i += 2)
    {
      hs.push_back({ { flat[i].data(), flat[i].size() }, { flat[i + 1].data(), flat[i + 1].size() } });
    }
    return hs;
  }

  /* content_length < 0 means unknown (streamed). Returns false if the client has gone away. */
  inline bool start(int64_t const id, int const status, object_ref const headers, int64_t const content_length)
  {
    auto * const req{ lookup(id) };
    auto const flat{ convert<std::vector<std::string>>::from_object(headers) };
    auto const hs{ to_headers(flat) };
    return req != nullptr
      && brrrr_start_response(req, status, hs.data(), hs.size(),
                              content_length < 0 ? SIZE_MAX : static_cast<size_t>(content_length)) == 0;
  }

  inline bool respond(int64_t const id, int const status, object_ref const headers, std::string const &body)
  {
    auto * const req{ lookup(id) };
    auto const flat{ convert<std::vector<std::string>>::from_object(headers) };
    auto const hs{ to_headers(flat) };
    return req != nullptr
      && brrrr_respond(req, status, hs.data(), hs.size(), brrrr_str_t{ body.data(), body.size() }) == 0;
  }

  inline bool write(int64_t const id, std::string const &data)
  {
    auto * const req{ lookup(id) };
    return req != nullptr && brrrr_write(req, brrrr_str_t{ data.data(), data.size() }) == 0;
  }

  inline void fail(int64_t const id)
  {
    if(auto * const req{ lookup(id) })
    { brrrr_fail(req); }
  }

  /* Keywords every request would otherwise intern afresh; the runtime keeps interned keywords
   * alive. (Caching boxed strings here as well, in GC-uncollectable cells, crashed under load:
   * the cached objects ended up freed or corrupted.) */
  struct constants_t
  {
    std::unordered_map<std::string_view, object_ref> methods;
    object_ref https, http;
  };

  inline constants_t const &constants()
  {
    static constants_t const c{ [] {
      constants_t c;
      for(auto const &[upper, lower] :
          { std::pair{ \"GET\", \"get\" }, { \"HEAD\", \"head\" }, { \"POST\", \"post\" }, { \"PUT\", \"put\" },
            { \"DELETE\", \"delete\" }, { \"OPTIONS\", \"options\" }, { \"PATCH\", \"patch\" } })
      { c.methods.emplace(upper, __rt_ctx->intern_keyword(lower).expect_ok().erase()); }
      c.https = __rt_ctx->intern_keyword(\"https\").expect_ok().erase();
      c.http = __rt_ctx->intern_keyword(\"http\").expect_ok().erase();
      return c;
    }() };
    return c;
  }

  inline object_ref box(brrrr_str_t const s)
  { return make_box(jtl::immutable_string_view{ s.base, s.len }).erase(); }

  /* Methods become lowercased keywords. */
  inline object_ref method_keyword(brrrr_str_t const m)
  {
    auto const &c{ constants() };
    if(auto const it{ c.methods.find(std::string_view{ m.base, m.len }) }; it != c.methods.end())
    { return it->second; }
    return __rt_ctx->intern_keyword(ascii_lower(std::string{ m.base, m.len })).expect_ok().erase();
  }

  inline object_ref scheme_keyword(brrrr_str_t const s)
  {
    auto const &c{ constants() };
    std::string_view const v{ s.base, s.len };
    if(v == \"https\") { return c.https; }
    if(v == \"http\") { return c.http; }
    return __rt_ctx->intern_keyword(std::string{ v }).expect_ok().erase();
  }

  inline object_ref protocol(int const version)
  {
    switch(version)
    {
      case 256: return make_box(\"HTTP/1.0\").erase();
      case 257: return make_box(\"HTTP/1.1\").erase();
      case 512: return make_box(\"HTTP/2.0\").erase();
      case 768: return make_box(\"HTTP/3.0\").erase();
      default: return make_box(jtl::immutable_string_view{ \"HTTP/\" + std::to_string(version) }).erase();
    }
  }

  /* The Ring header map. h2o has lowercased the names; repeated headers are joined with
   * commas, as other Ring adapters do. */
  inline object_ref header_map(brrrr_request_t const * const req)
  {
    std::vector<std::pair<std::string_view, std::string>> joined;
    joined.reserve(req->num_headers);
    for(size_t i{}; i < req->num_headers; ++i)
    {
      std::string_view const name{ req->headers[i].name.base, req->headers[i].name.len };
      std::string_view const value{ req->headers[i].value.base, req->headers[i].value.len };
      auto const it{ std::find_if(joined.begin(), joined.end(), [&](auto const &p) { return p.first == name; }) };
      if(it == joined.end())
      { joined.emplace_back(name, value); }
      else
      {
        it->second += ',';
        it->second += value;
      }
    }
    object_ref m{ transient(obj::persistent_array_map::empty().erase()) };
    for(auto const &[name, value] : joined)
    {
      m = assoc_in_place(m,
                         make_box(jtl::immutable_string_view{ name }).erase(),
                         make_box(jtl::immutable_string_view{ value }).erase());
    }
    return persistent(m);
  }

  /* With BRRRR_STATS set, GET /_brrrr/stats is answered here, without entering jank, with
   * the request count and the GC's totals: bb bench diffs them into bytes per request. */
  inline std::atomic<int64_t> &request_count()
  {
    static std::atomic<int64_t> n{};
    return n;
  }

  inline bool stats_request(brrrr_request_t * const req)
  {
    static bool const enabled{ std::getenv(\"BRRRR_STATS\") != nullptr };
    static std::string_view const path{ \"/_brrrr/stats\" };
    if(!enabled || std::string_view{ req->path.base, req->path.len } != path)
    { return false; }
    char body[256];
    int const len{ std::snprintf(body,
                                 sizeof(body),
                                 \"requests %lld\\nallocated_bytes %llu\\ngc_count %llu\\nheap_bytes %llu\\n\",
                                 static_cast<long long>(request_count().load()),
                                 static_cast<unsigned long long>(GC_get_total_bytes()),
                                 static_cast<unsigned long long>(GC_get_gc_no()),
                                 static_cast<unsigned long long>(GC_get_heap_size())) };
    brrrr_header_t const ct{ { \"content-type\", 12 }, { \"text/plain\", 10 } };
    brrrr_respond(req, 200, &ct, 1, brrrr_str_t{ body, static_cast<size_t>(len) });
    return true;
  }

  inline void handle(brrrr_request_t * const req)
  {
    static jank_object_ref const dispatch_var{ jank_var_intern_c(\"ring.adapter.h2o\", \"-dispatch\") };
    if(stats_request(req))
    { return; }
    request_count().fetch_add(1, std::memory_order_relaxed);
    auto &r{ registry() };
    int64_t id;
    {
      std::lock_guard<std::mutex> const lock{ r.mutex };
      id = r.next_id++;
      r.requests.emplace(id, req);
    }
    try
    {
      jank_call4(jank_deref(dispatch_var),
                 jank_integer_create(id),
                 jank_vector_create(8,
                                    method_keyword(req->method).raw(),
                                    str(req->path),
                                    str(req->query),
                                    scheme_keyword(req->scheme).raw(),
                                    str(req->authority),
                                    protocol(req->http_version).raw(),
                                    str(req->remote_addr),
                                    jank_integer_create(req->server_port)),
                 header_map(req).raw(),
                 req->has_body ? jank_const_true() : jank_const_false());
    }
    catch(...)
    {
      std::fputs(\"ring.adapter.h2o: dispatch failed\\n\", stderr);
      brrrr_fail(req);
    }
    std::lock_guard<std::mutex> const lock{ r.mutex };
    r.requests.erase(id);
  }

  /* Worker threads call into jank, so the GC has to know about them. */
  inline void worker_init()
  {
    GC_stack_base sb{};
    GC_get_stack_base(&sb);
    GC_register_my_thread(&sb);
  }

  inline int serve(char const *host, int const port, char const *cert, char const *key, int const workers,
                   int64_t const max_body, int64_t const initial_heap)
  {
    /* The GC collects whenever it has allocated a fraction of the heap; jank's default heap is
     * small, so a busy server stops the world for a full mark every few hundred requests. */
    if(auto const heap{ static_cast<int64_t>(GC_get_heap_size()) }; initial_heap > heap)
    { GC_expand_hp(static_cast<size_t>(initial_heap - heap)); }
    GC_allow_register_threads();
    brrrr_config_t const config{ host,          static_cast<uint16_t>(port),     cert,
                                 key,           handle,                          static_cast<size_t>(workers),
                                 worker_init,   static_cast<size_t>(max_body) };
    return brrrr_serve(&config);
  }
}")

(defonce ^:private current-handler (atom nil))

(defn- log [& args]
  (binding [*out* *err*]
    (apply println "ring.adapter.h2o:" args)))

(defn- server-name [authority]
  (cond
    (str/blank? authority)           nil
    (str/starts-with? authority "[") (subs authority 0 (inc (or (str/index-of authority "]")
                                                                (dec (count authority)))))
    :else                            (if-let [i (str/index-of authority ":")]
                                       (subs authority 0 i)
                                       authority)))

(defn- client-gone []
  (ex-info "client went away" {:type ::closed}))

(defn- body-reader [id]
  (fn read-chunk! []
    (let [chunk (cpp/ring_h2o.read_chunk id)]
      (if (= ::closed chunk)
        (throw (client-gone))
        chunk))))

(defn- build-request
  "The method and scheme arrive as keywords and the headers as a Ring header map,
  built by the C++ bridge (reusing boxed constants where it can)."
  [id [method uri query scheme authority protocol remote-addr server-port] headers has-body]
  (cond-> {:server-port    server-port
           :server-name    (server-name authority)
           :remote-addr    remote-addr
           :uri            uri
           :scheme         scheme
           :request-method method
           :protocol       protocol
           :headers        headers}
    query    (assoc :query-string query)
    has-body (assoc :body (body-reader id))))

(defn- flat-headers [headers]
  (vec (mapcat (fn [[k v]]
                 (let [k (cpp/ring_h2o.ascii_lower (name k))]
                   (if (sequential? v)
                     (mapcat (fn [x] [k (str x)]) v)
                     [k (str v)])))
               headers)))

(defn- write-fn [id]
  (fn write! [chunk]
    (when-not (cpp/ring_h2o.write id (str chunk))
      (throw (client-gone)))
    nil))

(defn- send-response! [id {:keys [status headers body]}]
  (let [status  (or status 200)
        headers (flat-headers headers)]
    (cond
      (nil? body)     (cpp/ring_h2o.respond id status headers "")
      (string? body)  (cpp/ring_h2o.respond id status headers body)
      (fn? body)      (when (cpp/ring_h2o.start id status headers -1)
                        (body (write-fn id)))
      (seqable? body) (when (cpp/ring_h2o.start id status headers -1)
                        (let [write! (write-fn id)]
                          (doseq [chunk body]
                            (write! chunk))))
      :else (throw (ex-info "Unsupported response body type" {:body body})))))

(defn- failed! [id description]
  (log "handler threw:" description)
  (cpp/ring_h2o.fail id))

(defn -dispatch
  "Called by the C++ bridge for every request. Not part of the public API."
  [id fields headers has-body]
  (try
    (let [request  (build-request id fields headers has-body)
          response (@current-handler request)]
      (send-response! id (or response
                             {:status 404 :headers {"content-type" "text/plain"} :body "Not Found"})))
    ;; jank's (catch :default e) binds e to nil, so catch the two concrete kinds.
    (catch cpp/jank.runtime.object_ref e
      (if (= ::closed (:type (ex-data e)))
        (cpp/ring_h2o.fail id)
        (failed! id (pr-str e))))
    (catch cpp/std.exception e
      (failed! id (.what e))))
  nil)

(defn run-h2o
  "Start h2o serving the Ring handler over HTTPS (h1, h2) and HTTP/3 on the same
  port, blocking the calling thread. Options:

  :host          - IPv4 address to bind (default \"0.0.0.0\")
  :port          - TCP and UDP port (default 8443)
  :cert-file     - PEM certificate chain (required)
  :key-file      - PEM private key (required)
  :threads       - worker threads running the handler (default 8)
  :max-body-size - largest request body accepted, in bytes (default 1GiB)
  :initial-heap-size - grow the GC heap to this many bytes at startup (default 64MiB):
                   fewer collections for more memory

  Pass a var (#'handler) to pick up redefinitions without restarting."
  [handler {:keys [host port cert-file key-file threads max-body-size initial-heap-size]
            :or   {host "0.0.0.0" port 8443 threads 8 max-body-size 1073741824
                   initial-heap-size 67108864}}]
  (when-not (and cert-file key-file)
    (throw (ex-info "run-h2o needs :cert-file and :key-file" {})))
  (reset! current-handler handler)
  (let [rc (cpp/ring_h2o.serve host port cert-file key-file threads max-body-size initial-heap-size)]
    (throw (ex-info "h2o failed to start" {:code rc}))))
