;; Ported from ring-codec 1.3.0 (MIT, see src/ring/LICENSE) for jank.
;; Differences: UTF-8 only (the encoding argument is accepted and ignored),
;; byte-level work is done in C++, no base64 (yet), form-encode dispatches
;; with cond instead of a protocol.
(ns ring.util.codec
  "Functions for encoding and decoding data."
  (:require [clojure.string :as str]))

(cpp/raw "#include <string>

namespace ring_codec
{
  inline char hex_digit(unsigned v) { return \"0123456789ABCDEF\"[v & 0xf]; }

  inline int hex_value(char c)
  {
    if(c >= '0' && c <= '9') { return c - '0'; }
    if(c >= 'a' && c <= 'f') { return c - 'a' + 10; }
    if(c >= 'A' && c <= 'F') { return c - 'A' + 10; }
    return -1;
  }

  inline void put_escaped(std::string &out, unsigned char c)
  {
    out += '%';
    out += hex_digit(c >> 4);
    out += hex_digit(c);
  }

  /* Every byte becomes %XX. */
  inline std::string percent_encode(std::string const &s)
  {
    std::string out;
    out.reserve(s.size() * 3);
    for(unsigned char c : s) { put_escaped(out, c); }
    return out;
  }

  /* Bytes outside [A-Za-z0-9_~.+-] become %XX (matches ring's url-encode). */
  inline std::string url_encode(std::string const &s)
  {
    std::string out;
    for(unsigned char c : s)
    {
      if(isalnum(c) || c == '_' || c == '~' || c == '.' || c == '+' || c == '-') { out += c; }
      else { put_escaped(out, c); }
    }
    return out;
  }

  /* java.net.URLEncoder semantics: [A-Za-z0-9.*_-] kept, space -> +, rest %XX. */
  inline std::string form_encode(std::string const &s)
  {
    std::string out;
    for(unsigned char c : s)
    {
      if(isalnum(c) || c == '.' || c == '*' || c == '_' || c == '-') { out += c; }
      else if(c == ' ') { out += '+'; }
      else { put_escaped(out, c); }
    }
    return out;
  }

  /* Decodes valid %XX sequences; leaves malformed ones untouched. */
  inline std::string percent_decode(std::string const &s)
  {
    std::string out;
    out.reserve(s.size());
    for(size_t i{}; i < s.size(); ++i)
    {
      int hi, lo;
      if(s[i] == '%' && i + 2 < s.size() && (hi = hex_value(s[i + 1])) >= 0 && (lo = hex_value(s[i + 2])) >= 0)
      {
        out += static_cast<char>((hi << 4) | lo);
        i += 2;
      }
      else { out += s[i]; }
    }
    return out;
  }

  /* java.net.URLDecoder semantics: + -> space, malformed % is an error. */
  inline bool form_decodable(std::string const &s)
  {
    for(size_t i{}; i < s.size(); ++i)
    {
      if(s[i] == '%')
      {
        if(i + 2 >= s.size() || hex_value(s[i + 1]) < 0 || hex_value(s[i + 2]) < 0) { return false; }
        i += 2;
      }
    }
    return true;
  }

  inline std::string form_decode(std::string const &s)
  {
    std::string plus_free{ s };
    for(auto &c : plus_free) { if(c == '+') { c = ' '; } }
    return percent_decode(plus_free);
  }
}")

(defn assoc-conj
  "Associate a key with a value in a map. If the key already exists in the map,
  a vector of values is associated with the key."
  [map key val]
  (assoc map key
    (if-let [cur (get map key)]
      (if (vector? cur)
        (conj cur val)
        [cur val])
      val)))

(defn percent-encode
  "Percent-encode every byte of the given string's UTF-8 encoding."
  ([unencoded] (cpp/ring_codec.percent_encode unencoded))
  ([unencoded _encoding] (percent-encode unencoded)))

(defn percent-decode
  "Decode every percent-encoded byte in the given string."
  ([encoded] (cpp/ring_codec.percent_decode encoded))
  ([encoded _encoding] (percent-decode encoded)))

(defn url-encode
  "Returns the url-encoded version of the given string."
  ([unencoded] (cpp/ring_codec.url_encode (str unencoded)))
  ([unencoded _encoding] (url-encode unencoded)))

(defn url-decode
  "Returns the url-decoded version of the given string."
  ([encoded] (percent-decode encoded))
  ([encoded _encoding] (url-decode encoded)))

(defn- form-encode-str [x]
  (cpp/ring_codec.form_encode (str x)))

(defn form-encode
  "Encode the supplied value into www-form-urlencoded format, often used in
  URL query strings and POST request bodies."
  ([x]
   (cond
     (nil? x) ""
     (map? x)
     (letfn [(encode-param [k v] (str (form-encode-str (name k)) "=" (form-encode v)))]
       (->> x
            (mapcat
             (fn [[k v]]
               (cond
                 (sequential? v) (map #(encode-param k %) v)
                 (set? v)        (sort (map #(encode-param k %) v))
                 :else           (list (encode-param k v)))))
            (str/join "&")))
     :else (form-encode-str x)))
  ([x _encoding] (form-encode x)))

(defn form-decode-str
  "Decode the supplied www-form-urlencoded string. Returns nil if it is malformed."
  ([encoded]
   (if (or (str/includes? encoded "+") (str/includes? encoded "%"))
     (when (cpp/ring_codec.form_decodable encoded)
       (cpp/ring_codec.form_decode encoded))
     encoded))
  ([encoded _encoding] (form-decode-str encoded)))

(defn- split-key-value-pair [s]
  (if-let [i (str/index-of s "=")]
    [(subs s 0 i) (subs s (inc i))]
    [s ""]))

(defn form-decode-map
  "Decode the supplied www-form-urlencoded string into a map of key/value pairs,
  as defined by https://url.spec.whatwg.org/#urlencoded-parsing"
  ([encoded]
   (reduce
    (fn [m param]
      (if (= "" param)
        m
        (let [[k v] (split-key-value-pair param)
              k     (form-decode-str k)
              v     (form-decode-str v)]
          (if (and k v)
            (assoc-conj m k v)
            m))))
    {}
    (str/split encoded #"&")))
  ([encoded _encoding] (form-decode-map encoded)))

(defn form-decode
  "Decode the supplied www-form-urlencoded string. If the encoded value is a
  string, a string is returned. If it is a map of parameters, a map is returned."
  ([encoded]
   (if-not (str/includes? encoded "=")
     (form-decode-str encoded)
     (form-decode-map encoded)))
  ([encoded _encoding] (form-decode encoded)))
