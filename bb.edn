{:paths ["test"]
 :tasks
 {:requires ([babashka.fs :as fs] [clojure.string :as str])

  submodules
  {:doc  "Fetch vendor/h2o if needed (jank-build.bb runs sandboxed, without network)"
   :task (when-not (fs/exists? "vendor/h2o/CMakeLists.txt")
           (shell "git submodule update --init vendor/h2o"))}

  cert
  {:doc  "Self-signed dev certificate in certs/"
   ;; Plain ecparam + req with a config file, so this works with LibreSSL (macOS's
   ;; /usr/bin/openssl) as well as OpenSSL.
   :task (when-not (fs/exists? "certs/cert.pem")
           (fs/create-dirs "certs")
           (spit "certs/openssl.cnf"
                 (str "[req]\ndistinguished_name=dn\nprompt=no\n[dn]\nCN=localhost\n"
                      "[v3]\nsubjectAltName=DNS:localhost,IP:127.0.0.1\n"
                      "basicConstraints=CA:FALSE\nkeyUsage=digitalSignature\n"
                      "extendedKeyUsage=serverAuth\n"))
           (shell "openssl ecparam -name prime256v1 -genkey -noout -out certs/key.pem")
           (shell (str "openssl req -new -x509 -days 365 -key certs/key.pem -out certs/cert.pem"
                       " -config certs/openssl.cnf -extensions v3")))}

  keystore
  {:doc     "The dev certificate as a PKCS12 keystore, for the JVM version"
   :depends [cert]
   :task    (when-not (fs/exists? "certs/keystore.p12")
              (shell (str "openssl pkcs12 -export -in certs/cert.pem -inkey certs/key.pem -name localhost"
                          " -out certs/keystore.p12 -passout pass:go-brrrr"
                          " -keypbe AES-256-CBC -certpbe AES-256-CBC -macalg sha256")))}

  run
  {:doc     "Run the app under the JIT: bb run [port]"
   :override-builtin true
   :depends [submodules cert]
   :task    (apply shell "lein run --" *command-line-args*)}

  build
  {:doc     "Release binary at target/release/go-brrrr (statically linked)"
   :depends [submodules]
   ;; jank's compile-time JIT loads cached module objects, which then pull h2o's
   ;; static archive into the JIT, which cannot link its TLS relocations; so the
   ;; release build starts from an empty module cache. The native build output
   ;; lives elsewhere in _cache and is kept.
   :task    (let [bin "target/release/go-brrrr"
                  inputs ["src" "native" "vendor/h2o" "project.clj" "jank-build.bb"]]
              (if (and (fs/exists? bin) (empty? (fs/modified-since bin inputs)))
                (println bin "is up to date")
                (do (fs/delete-tree "target/release/_cache/go-brrrr")
                    (shell "lein with-profile +release compile"))))}

  build:echo
  {:doc     "Echo test server at target/debug/echo-server (for the adapter tests)"
   :depends [submodules]
   :task    (shell "lein with-profile +test compile -m server.echo -n echo-server")}

  test:unit
  {:doc     "jank unit tests (ported ring tests and adapter helpers): lein test"
   :depends [submodules]
   :task    (apply shell "lein test" *command-line-args*)}

  test:integration
  {:doc      "Adapter integration tests over h1/h2/h3: bb test:integration [ns ...]"
   :depends  [build:echo cert]
   :requires ([integration.runner :as runner])
   :task     (runner/run! runner/adapter-nses *command-line-args*)}

  test:app
  {:doc      "The app's endpoints, as the release binary and under the JIT"
   :depends  [build cert]
   :requires ([integration.runner :as runner])
   :task     (runner/run! runner/app-nses *command-line-args*)}

  bench
  {:doc      "Fixed-rate load test with h2load: bb bench [--rate 100] [--duration 60] [--protocols h1,h2,h3]"
   :depends  [build cert]
   :requires ([bench.load :as load])
   :task     (apply load/-main *command-line-args*)}

  bench:report
  {:doc      "Chart every results file in bench-results/ into bench-results/report.html"
   :requires ([bench.report :as report])
   :task     (apply report/-main *command-line-args*)}

  build:ref
  {:doc     "The reference h2o app (reference/h2o_ref.cc) at target/reference/h2o-ref"
   :depends [build]
   :task    (let [bin "target/reference/h2o-ref"
                  lib (first (fs/glob "target/release/_cache" "go-brrrr-out-*/lib"))
                  ssl (or (System/getenv "OPENSSL_ROOT_DIR")
                          (some (fn [p] (when (fs/exists? (fs/path p "include" "openssl" "ssl.h")) (str p)))
                                ["/opt/homebrew/opt/openssl@3" "/usr/local/opt/openssl@3"]))]
              (if (and (fs/exists? bin) (empty? (fs/modified-since bin ["reference" (str lib)])))
                (println bin "is up to date")
                (do (fs/create-dirs "target/reference")
                    (apply shell "clang++" "-O2" "-std=c++20" "-pthread" "-Wall" "-Wextra"
                           "-Wno-unused-parameter" "-Wno-missing-field-initializers"
                           "-DH2O_USE_LIBUV=0" "-DQUICLY_USE_TRACER=1"
                           "-Ivendor/h2o/include" "-Ivendor/h2o/deps/picotls/include"
                           "-Ivendor/h2o/deps/quicly/include"
                           (concat (when ssl [(str "-I" ssl "/include")])
                                   ["reference/h2o_ref.cc" "-o" bin (str (fs/path lib "libh2o-evloop.a"))]
                                   (when ssl [(str "-L" ssl "/lib")])
                                   ["-lssl" "-lcrypto" "-lz" "-lm"])))))}

  bench:ref
  {:doc      "The same load test against the reference h2o app, h2 only by default: bb bench:ref [options]"
   :depends  [build:ref cert]
   :requires ([bench.load :as load])
   :task     (let [sha (str/trim (:out (shell {:out :string} "git rev-parse --short HEAD")))
                   os  (if (str/includes? (System/getProperty "os.name") "Mac") "macos" "linux")]
               (apply load/-main "--binary" "target/reference/h2o-ref" "--label" (str os "-h2o-ref-" sha)
                      "--commit" sha "--protocols" "h2" *command-line-args*))}

  bench:jvm
  {:doc      "The same load test against the JVM version (jvm/), labelled <os>-jvm-<sha>: bb bench:jvm [options]"
   :depends  [keystore]
   :requires ([bench.load :as load])
   :task     (let [os  (if (str/includes? (System/getProperty "os.name") "Mac") "macos" "linux")
                   sha (str/trim (:out (shell {:out :string} "git rev-parse --short HEAD")))]
               (apply load/-main "--binary" "jvm/go-brrrr-jvm" "--label" (str os "-jvm-" sha)
                      "--commit" sha *command-line-args*))}

  test
  {:doc     "All tests"
   :depends [test:unit test:integration test:app]}

  clean
  {:doc  "Remove build output (keeps certs/)"
   :task (fs/delete-tree "target")}}}
